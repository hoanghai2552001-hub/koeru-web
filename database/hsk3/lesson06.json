      "vi": ""
    },
    {
      "part": 1,
      "topic": "在客厅",
      "spk": "周太太",
      "p": "Wǒ méi kàn jiàn a.",
      "zh": "我没看见啊。",
      "vi": ""
    },
    {
      "part": 1,
      "topic": "在客厅",
      "spk": "周明",
      "p": "Wǒ lí bu kāi yǎn jìng, méi yǒu yǎn jìng, wǒ yí ge zì yě kàn bu qīng chu.",
