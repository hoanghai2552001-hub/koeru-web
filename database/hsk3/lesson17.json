      "part": 1,
      "topic": "在公司",
      "spk": "小丽",
      "p": "Wǒ de yí ge lǎo péng yǒu jié hūn， wǒ gēn tā liǎng nián méi jiàn le.",
      "zh": "三天。",
      "vi": ""
    },
    {
      "part": 2,
      "topic": "在公司",
      "spk": "同事",
      "p": "Wǒ men guò qù shì lín jū, hòu lái shì dà xué tóng xué,",
      "zh": "小丽，那个高高的男人是你们公司的吗？",
      "vi": ""
    },
    {
      "part": 2,
      "topic": "在公司",
      "spk": "小丽",
      "p": "Xiǎo lì, nà ge gāo gāo de nán rén shì nǐ men gōng sī de ma？",
      "zh": "我们过去是邻居，后来是大学同学，",
      "vi": ""
    },
    {
      "part": 2,
      "topic": "在公司",
      "spk": "",
      "p": "tóng shì: Tā yì bān xǐ huan zuò shén me？",
      "zh": "关系一直很不错。",
      "vi": ""
    },
    {
      "part": 2,
      "topic": "在公司",
      "spk": "同事",
      "p": "guān xì yì zhí hěn bù cuò.",
      "zh": "他一般喜欢做什么？",
      "vi": ""
    },
    {
      "part": 2,
      "topic": "在公司",
      "spk": "小丽",
      "p": "Zhēn de？Nà nǐ jiè shào wǒ men rèn shi rèn shi ba.",
      "zh": "他有很多爱好，唱歌、画画儿、踢足球什么都会。",
      "vi": ""
    },
    {
      "part": 2,
      "topic": "在公司",
      "spk": "同事",
      "p": "Tā yǒu hěn duō ài hào, chàng gē, huà huàr, tī zú qiú shén me dōu huì.",
      "zh": "真的？那你介绍我们认识认识吧。",
      "vi": ""
    },
    {
      "part": 2,
      "topic": "在公司",
      "spk": "小丽",
      "p": "Bù xíng, xiàn zài tā shì wǒ zhàng fu.",
      "zh": "不行，现在他是我丈夫。",
      "vi": ""
    },
    {
      "part": 3,
      "topic": "在家",
      "spk": "周太太",
      "p": "Zuì jìn wǒ jué de nǎr dōu bù shū fu, nǐ dài wǒ qù yī yuàn jiǎn chá jiǎn cha ba.",
      "zh": "最近我觉得哪儿都不舒服，你带我去医院检查检查吧。",
      "vi": ""
    },
    {
      "part": 3,
      "topic": "在家",
      "spk": "周 明",
      "p": "Wǒ wèn nǐ, nǐ duō jiǔ méi yùn dòng le？",
      "zh": "不用去医院，谁都有办法看好你的“病”。",
      "vi": ""
    },
    {
      "part": 3,
      "topic": "在家",
      "spk": "",
      "p": "Zhōu míng: Bù yòng qú yī yuàn, shéi dōu yǒu bàn fǎ kàn hǎo nǐ de“bìng”.",
      "zh": "我问你，你多久没运动了？",
      "vi": ""
    },
    {
      "part": 3,
      "topic": "在家",
      "spk": "周太太",
      "p": "Wèi le jiàn kāng, wǒ zhēn yīng gāi duō duàn liàn duàn lian le.",
      "zh": "我三年没运动了。",
      "vi": ""
    },
    {
      "part": 3,
      "topic": "在家",
      "spk": "周 明",
      "p": "Shéi dōu zhī dào yùn dòng duì shēn tǐ hǎo. Dàn shì nǐ chī bǎo le jiù shuì.",
      "zh": "谁都知道运动对身体好。但是你吃饱了就睡。",
      "vi": ""
    },
    {
      "part": 3,
      "topic": "在家",
      "spk": "周太太",
      "p": "Wǒ sān nián méi yùn dòng le.",
      "zh": "为了健康，我真应该多锻炼锻炼。",
      "vi": ""
