      "vi": ""
    },
    {
      "part": 2,
      "topic": "在家里",
      "spk": "B",
      "p": "Wǒ kàn yí xià ，bú shì ，shì sòng niú nǎi de.",
      "zh": "我看一下，不是，是送牛奶的。",
      "vi": ""
    },
    {
      "part": 3,
      "topic": "在家里",
      "spk": "A",
      "p": "Zhè shì shuí de fáng jiān？",
      "zh": "这是谁的房间？",
      "vi": ""
    },
    {
      "part": 3,
      "topic": "在家里",
      "spk": "B",
      "p": "Zhè shì wǒ hé wǒ zhàng fu de，",
      "zh": "这是我和我丈夫的，",
      "vi": ""
    },
    {
      "part": 3,
      "topic": "在家里",
      "spk": "",
      "p": "Páng biān nà ge xiǎo de fáng jiān shì wǒ nǚ ér de 。",
      "zh": "旁边那个小的房间是我女儿的。",
      "vi": ""
    },
    {
      "part": 3,
      "topic": "在家里",
      "spk": "A",
      "p": "Nǐ nǚ ér de fáng jiān zhēn piào liang ！Dōu shì fěn sè de。",
      "zh": "你女儿的房间真漂亮！都是粉色的。",
      "vi": ""
    },
    {
      "part": 3,
      "topic": "在家里",
      "spk": "B",
      "p": "Shì ā ，fěn sè shì wǒ nǚ ér zuì xǐ huān de yán sè 。",
      "zh": "是啊，粉色是我女儿最喜欢的颜色。",
      "vi": ""
    },
    {
      "part": 4,
      "topic": "在办公室",
      "spk": "A",
      "p": "Nǐ kàn jiàn wǒ de bēi zi le ma ？",
