    {
      "part": 1,
      "topic": "在运动场",
      "spk": "A",
      "p": "Nǐ hěn shǎo shēng bìng ，shì bú shì xǐ huān yùn dòng ？",
      "zh": "你很少生病，是不是喜欢运动？",
      "vi": ""
    },
    {
      "part": 1,
      "topic": "在运动场",
      "spk": "B",
      "p": "Shì ā ，wǒ měi tiān zǎo shang dōu yào chū qù pǎo bù 。",
      "zh": "是啊，我每天早上都要出去跑步。",
      "vi": ""
    },
    {
      "part": 1,
      "topic": "在运动场",
      "spk": "A",
      "p": "Nǐ měi tiān jǐ diǎn qǐ chuáng ？",
      "zh": "你每天几点起床？",
      "vi": ""
    },
    {
      "part": 1,
      "topic": "在运动场",
      "spk": "B",
      "p": "Wǒ měi tiān liù diǎn qǐ chuáng 。",
      "zh": "我每天六点起床。",
      "vi": ""
    },
    {
      "part": 2,
      "topic": "在医院",
      "spk": "A",
      "p": "Chī yào le ma ？xiàn zài shēn tǐ zěn me yàng ？",
      "zh": "吃药了吗？现在身体怎么样？",
      "vi": ""
    },
    {
      "part": 2,
      "topic": "在医院",
      "spk": "B",
      "p": "Chī le ，xiàn zài hǎo duō le 。",
      "zh": "吃了，现在好多了。",
      "vi": ""
    },
    {
      "part": 2,
      "topic": "在医院",
      "spk": "A",
      "p": "Shén me shí hou néng chū yuàn ？",
      "zh": "什么时候能出院？",
      "vi": ""
    },
    {
      "part": 2,
      "topic": "在医院",
      "spk": "B",
      "p": "Yī shēng shuō xià ge xīng qī 。",
      "zh": "医生说下个星期。",
      "vi": ""
    },
    {
      "part": 3,
      "topic": "在操场",
      "spk": "A",
      "p": "Dà wèi jīn nián duō dà ？",
      "zh": "大卫今年多大？",
      "vi": ""
    },
    {
      "part": 3,
      "topic": "在操场",
      "spk": "B",
      "p": "èr shí duō suì 。",
      "zh": "二十多岁。",
      "vi": ""
    },
    {
      "part": 3,
      "topic": "在操场",
      "spk": "A",
      "p": "Tā duō gāo ？",
      "zh": "他多高？",
      "vi": ""
    },
    {
      "part": 3,
      "topic": "在操场",
      "spk": "B",
      "p": "Yī mǐ bā jǐ 。",
      "zh": "一米八几。",
      "vi": ""
    },
    {
      "part": 3,
      "topic": "在操场",
      "spk": "A",
      "p": "Nǐ zěn me zhī dào zhè me duō ya ？",
      "zh": "你怎么知道这么多呀？",
      "vi": ""
    },
    {
      "part": 3,
      "topic": "在操场",
      "spk": "B",
      "p": "Tā shì wǒ tóng xué 。",
      "zh": "他是我同学。",
      "vi": ""
    },
    {
      "part": 4,
      "topic": "在房间",
      "spk": "A",
      "p": "Zhāng lǎo shī xīng qī liù yě bù xiū xi ā ？",
      "zh": "张老师星期六也不休息啊？",
      "vi": ""
    },
    {
      "part": 4,
      "topic": "在房间",
      "spk": "B",
      "p": "Shì ā ，tā zhè jǐ tiān hěn máng ，méi yǒu shí jiān xiū xi 。",
      "zh": "是啊，他这几天很忙，没有时间休息。",
      "vi": ""
    },
    {
      "part": 4,
      "topic": "在房间",
      "spk": "A",
      "p": "Nà huì hěn lèi ba ？",
      "zh": "那会很累吧？",
      "vi": ""
    },
    {
      "part": 4,
      "topic": "在房间",
      "spk": "B",
      "p": "Tā měi tiān huí lái dōu hěn lèi 。",
